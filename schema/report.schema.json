      "description": "One recorded step. Every conclusion traces back to one of these.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "action",
        "detail",
