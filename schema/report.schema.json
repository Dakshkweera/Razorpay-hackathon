          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "check",
        "reason"
      ],
      "title": "RuledOut",
      "type": "object"
    },
    "RunMeta": {
      "properties": {
        "data_dir": {
          "default": "",
          "title": "Data Dir",
          "type": "string"
        },
        "deterministic_hash": {
          "default": "",
          "title": "Deterministic Hash",
          "type": "string"
        },
        "llm_cache_hits": {
          "default": 0,
