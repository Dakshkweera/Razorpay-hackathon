          "default": 0.0,
          "title": "Gap Accuracy Pct",
          "type": "number"
        }
      },
      "required": [
        "batches",
        "cases",
        "cases_failed",
        "cases_passed",
        "cases_pending",
        "cases_total",
        "false_cause_attributions",
        "false_matches",
        "gap_accuracy_pct"
      ],
      "title": "EvalReport",
      "type": "object"
    },
    "ExceptionKind": {
      "enum": [
        "ambiguous_match",
        "duplicate_utr",
        "unmatched_bank_credit",
        "unmatched_settlement",
        "unexplained_residue"
      ],
      "title": "ExceptionKind",
      "type": "string"
    },
    "ExceptionReport": {
      "description": "An honest exception, built to be actionable rather than a dump.\n\n``tried`` and ``ruled_out`` are what separate \"we could not explain this\" from\n\"we did not look\". A finance team can act on the first and cannot act on the\nsecond.",
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "bank_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bank Ref"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExceptionKind"
        },
        "needs": {
          "default": "",
          "title": "Needs",
          "type": "string"
        },
        "ruled_out": {
          "items": {
            "$ref": "#/$defs/RuledOut"
          },
          "title": "Ruled Out",
          "type": "array"
        },
        "settlement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Id"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "tried": {
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "title": "Tried",
          "type": "array"
        },
        "what": {
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "bank_ref",
        "candidates",
        "confidence",
        "id",
        "kind",
        "needs",
        "ruled_out",
        "settlement_id",
        "threshold",
        "tried",
        "what"
      ],
      "title": "ExceptionReport",
      "type": "object"
    },
    "GapComponent": {
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "attributed": {
          "default": true,
          "title": "Attributed",
          "type": "boolean"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "source": {
          "$ref": "#/$defs/ComponentSource"
        }
      },
      "required": [
        "amount",
        "attributed",
        "check",
        "confidence",
        "detail",
        "kind",
        "source"
      ],
      "title": "GapComponent",
      "type": "object"
    },
