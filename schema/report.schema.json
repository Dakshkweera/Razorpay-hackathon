        "adjustment_count",
        "bank_credit",
        "bank_date",
        "bank_narration",
        "bank_ref",
        "components",
        "explained",
        "gross_settled",
        "headline_gap",
        "match",
        "orders_expected",
        "payment_count",
        "refund_count",
        "residual",
        "row_count",
        "settled_at",
        "settlement_expected_credit",
        "settlement_id",
        "settlement_residual",
        "total_fee",
        "total_tax",
        "trace",
        "utr",
        "window_end",
        "window_start"
      ],
      "title": "BatchReport",
      "type": "object"
    },
    "CaseStatus": {
      "enum": [
        "pass",
        "fail",
        "pending"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "ColumnMapping": {
      "properties": {
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "title": "Confidence",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/MappingMethod"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "canonical",
        "confidence",
        "method",
        "source"
      ],
      "title": "ColumnMapping",
      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "fee",
        "gst_on_fee",
        "fee_rate_drift",
        "cross_cycle_refund",
        "unlinked_adjustment",
        "rounding",
        "unexplained"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentSource": {
      "enum": [
        "deterministic",
        "llm"
      ],
      "title": "ComponentSource",
      "type": "string"
    },
    "Count": {
      "properties": {
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        },
        "pct": {
          "default": 0.0,
          "title": "Pct",
          "type": "number"
        }
      },
      "required": [
        "n",
        "pct"
      ],
      "title": "Count",
      "type": "object"
    },
    "EvalBatch": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/EvalComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "passed": {
          "default": false,
          "title": "Passed",
          "type": "boolean"
        },
        "reported_gap": {
          "title": "Reported Gap",
          "type": "integer"
        },
        "settlement_id": {
          "title": "Settlement Id",
          "type": "string"
        },
        "truth_gap": {
          "title": "Truth Gap",
          "type": "integer"
        }
      },
      "required": [
        "components",
        "passed",
        "reported_gap",
        "settlement_id",
        "truth_gap"
      ],
      "title": "EvalBatch",
      "type": "object"
    },
    "EvalCase": {
      "description": "One of the planted cases from the PRD's table, scored explicitly.",
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        }
      },
      "required": [
        "actual",
        "expected",
        "name",
        "number",
        "status"
      ],
      "title": "EvalCase",
      "type": "object"
    },
    "EvalComponent": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "reported_amount": {
          "title": "Reported Amount",
          "type": "integer"
        },
        "truth_amount": {
          "title": "Truth Amount",
          "type": "integer"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "kind",
        "reported_amount",
        "truth_amount",
        "verdict"
      ],
      "title": "EvalComponent",
      "type": "object"
    },
    "EvalReport": {
      "properties": {
        "batches": {
          "items": {
            "$ref": "#/$defs/EvalBatch"
          },
          "title": "Batches",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/EvalCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "cases_failed": {
          "default": 0,
          "title": "Cases Failed",
          "type": "integer"
        },
        "cases_passed": {
          "default": 0,
          "title": "Cases Passed",
          "type": "integer"
        },
        "cases_pending": {
          "default": 0,
          "title": "Cases Pending",
          "type": "integer"
        },
        "cases_total": {
          "default": 0,
          "title": "Cases Total",
          "type": "integer"
        },
        "false_cause_attributions": {
          "default": 0,
          "title": "False Cause Attributions",
          "type": "integer"
        },
        "false_matches": {
          "default": 0,
          "title": "False Matches",
          "type": "integer"
        },
