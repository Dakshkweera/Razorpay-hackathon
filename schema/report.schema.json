        "matched_inference": {
          "$ref": "#/$defs/Count"
        },
        "order_rows": {
          "default": 0,
          "title": "Order Rows",
          "type": "integer"
        },
        "records_processed": {
          "default": 0,
          "title": "Records Processed",
          "type": "integer"
        },
        "runtime_ms": {
          "default": 0,
          "title": "Runtime Ms",
          "type": "integer"
        },
        "settlement_batches": {
