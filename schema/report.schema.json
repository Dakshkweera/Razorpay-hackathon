      "title": "Match",
      "type": "object"
    },
    "MatchOrigin": {
      "enum": [
        "deterministic",
        "inference",
        "none"
      ],
      "title": "MatchOrigin",
      "type": "string"
    },
    "MatchRule": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "none"
      ],
      "title": "MatchRule",
      "type": "string"
    },
    "NarrationRead": {
      "description": "What was read off one bank line, and by what.\n\n``source`` is the point of this record: it distinguishes what a regular expression\ncould see from what a model was needed for, which is how the AI's contribution\nstops being a claim and becomes a number.",
      "properties": {
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty"
        },
        "kind": {
          "default": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "matched_settlement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Settlement Id"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "source": {
          "default": "regex",
          "title": "Source",
          "type": "string"
        },
        "utrs": {
          "items": {
            "type": "string"
          },
          "title": "Utrs",
          "type": "array"
        }
      },
      "required": [
        "confidence",
        "counterparty",
        "kind",
        "matched_settlement_id",
        "notes",
        "raw",
        "ref",
        "source",
        "utrs"
      ],
      "title": "NarrationRead",
      "type": "object"
    },
    "NormaliseReport": {
      "properties": {
        "columns_mapped": {
          "items": {
            "$ref": "#/$defs/ColumnMapping"
          },
