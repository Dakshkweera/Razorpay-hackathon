    "Match": {
      "properties": {
        "bank_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bank Ref"
        },
        "basis": {
          "default": "",
          "title": "Basis",
          "type": "string"
        },
        "candidates_considered": {
          "default": 0,
          "title": "Candidates Considered",
          "type": "integer"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "origin": {
          "$ref": "#/$defs/MatchOrigin",
          "default": "none"
