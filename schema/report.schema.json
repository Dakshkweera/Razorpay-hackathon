          "title": "Payment Count",
          "type": "integer"
        },
        "refund_count": {
          "default": 0,
          "title": "Refund Count",
          "type": "integer"
        },
        "residual": {
          "default": 0,
          "title": "Residual",
          "type": "integer"
        },
        "row_count": {
          "default": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "settled_at": {
          "format": "date-time",
          "title": "Settled At",
          "type": "string"
        },
        "settlement_expected_credit": {
          "default": 0,
          "title": "Settlement Expected Credit",
          "type": "integer"
        },
        "settlement_id": {
          "title": "Settlement Id",
          "type": "string"
        },
        "settlement_residual": {
          "default": 0,
          "title": "Settlement Residual",
          "type": "integer"
        },
        "total_fee": {
          "default": 0,
          "title": "Total Fee",
          "type": "integer"
        },
        "total_tax": {
          "default": 0,
          "title": "Total Tax",
          "type": "integer"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/TraceEntry"
          },
          "title": "Trace",
          "type": "array"
        },
        "utr": {
          "title": "Utr",
          "type": "string"
        },
        "window_end": {
          "format": "date",
