# Only needed to regenerate fixtures/llm/*.json - the demo runs from cache.
#
# Any OpenAI-compatible gateway serving a Sonar model works. Leave BASE_URL unset
# for Perplexity direct (keys start `pplx-`); point it at OpenRouter for an
# OpenRouter key (`sk-or-`), which is a different service and rejects the other's.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# PERPLEXITY_BASE_URL=https://openrouter.ai/api/v1   # then MODEL=perplexity/sonar
